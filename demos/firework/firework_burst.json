		{ "kind": "affector", "name": "Gravity", "path": "../../modules/affectors/Gravity.glsl" },
		{ "kind": "affector", "name": "Wind", "path": "../../modules/affectors/Wind.glsl" },
		{ "kind": "affector", "name": "Integrate", "path": "../../modules/affectors/Integrate.glsl" },
