#include "xincbin.h"

#ifdef RC_INVOKED
// Changes whenever a glsl file does, so the resource compiler's dependency
// scan (which only sees #includes, never RCDATA payloads) re-embeds them
#include "glsl_stamp.h"
#endif

XINCBIN(grain_update_fs, GRAIN_SRC_DIR "glsl/update.frag.glsl")
XINCBIN(grain_render_vs, GRAIN_SRC_DIR "glsl/render.vert.glsl")
XINCBIN(grain_render_fs, GRAIN_SRC_DIR "glsl/render.frag.glsl")
XINCBIN(grain_api, GRAIN_SRC_DIR "glsl/api.glsl")
XINCBIN(grain_sdf, GRAIN_SRC_DIR "glsl/sdf.glsl")
XINCBIN(grain_transform, GRAIN_SRC_DIR "glsl/transform.glsl")
XINCBIN(grain_internal, GRAIN_SRC_DIR "glsl/internal.glsl")
XINCBIN(grain_inspect_stub, GRAIN_SRC_DIR "glsl/inspect.glsl")
XINCBIN(grain_probe_vs, GRAIN_SRC_DIR "glsl/probe.vert.glsl")
XINCBIN(grain_probe_fs, GRAIN_SRC_DIR "glsl/probe.frag.glsl")
